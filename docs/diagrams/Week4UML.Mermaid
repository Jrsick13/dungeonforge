classDiagram
    direction TB

%% Styling blocks to make design patterns clear and separate
    class GameConfig {
        <<Singleton>>
        -static GameConfig instance
        -Map~String, Object~ settings
        -GameConfig()
        +static GameConfig getInstance()
        +int getInt(String, int)
        +long getLong(String, long)
        +static String readResource(String)
        +static void resetForTests()
    }

    class RandomSource {
        <<Singleton>>
        -static RandomSource instance
        -Random random
        -RandomSource()
        +static RandomSource getInstance()
        +void reseed(long)
        +int nextInt(int)
        +long getSeed()
        +static void resetForTests()
    }

    class MonsterFactory {
<<Simple Factory>>
-Map~String, MonsterDef~ blueprints
+MonsterFactory()
-void loadFrom(String)
+void register(String, MonsterDef)
+Monster create(String, int)
+List~String~ idsForTheme(String)
+String bossIdForTheme(String)
}

class MonsterDef {
-String id
-String name
-int hp
-int attack
-int xp
-String theme
-boolean boss
+MonsterDef(String, String, int, int, int, String)
+MonsterDef(String, String, int, int, int, String, boolean)
+String getId()
+String getName()
+int getHp()
+int getAttack()
+int getXp()
+String getTheme()
+boolean isBoss()
+String toString()
    }

class Entity {
<<abstract>>
#String name
#int hp
#int maxHp
#int attackPower
#int defense
#Entity(String, int, int, int)
+String getName()
+int getHp()
+int getMaxHp()
+int getAttackPower()
+int getDefense()
+boolean isAlive()
+void takeDamage(int)
+void heal(int)
+String describe()*
+String toString()
}

class Player {
-int gold
-int xp
+Player(String)
+int getGold()
+int getXp()
+void addGold(int)
+void addXp(int)
+double carryCapacity()
+String describe()
}

class Monster {
-String species
-int xpReward
+Monster(String, int, int, int)
+String getSpecies()
+int getXpReward()
+String describe()
}

class Item {
<<interface>>
+String getName()
+double getWeight()
+int getValue()
+String describe()
}

