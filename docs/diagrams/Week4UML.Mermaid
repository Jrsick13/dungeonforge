    }

class Chest {
-String name
-List~Item~ contents
+Chest(String)
+String getName()
+List~Item~ getContents()
+void add(Item)
+boolean isEmpty()
+int totalValue()
}

class Room {
-String id
-String flavor
-List~Monster~ monsters
-List~Item~ floorItems
-Chest chest
+Room(String)
+String getId()
+String getFlavor()
+void setFlavor(String)
+List~Monster~ getMonsters()
+void addMonster(Monster)
+List~Item~ getFloorItems()
+void addItem(Item)
+Chest getChest()
+void setChest(Chest)
+boolean hasChest()
}

class DungeonLevel {
-int depth
-List~Room~ rooms
+DungeonLevel(int)
+int getDepth()
+List~Room~ getRooms()
+void addRoom(Room)
}

class GameWorld {
-Player player
-List~DungeonLevel~ levels
-MonsterFactory monsterFactory
+GameWorld(Player)
-void generate()
-Monster spawn(int)
+Player getPlayer()
+List~DungeonLevel~ getLevels()
+int totalMonsters()
}

class Main {
+String VERSION
-Main()
+static String banner()
+static void main(String[])
}

class Json {
-String s
-int i
-Json(String)
+static Map~String, Object~ parseObject(String)
-void ws()
-Object value()
-Map~String, Object~ object()
-List~Object~ array()
-String string()
-Double number()
}

%% Relationships and Inheritances
Entity <|-- Player
Entity <|-- Monster
Item <|.. Weapon
Item <|.. Armor
Item <|.. Potion
Item <|.. Treasure

MonsterFactory --> MonsterDef : manages / loads
MonsterFactory --> Monster : creates
GameWorld --> MonsterFactory : uses (Simple Factory)
GameWorld --> DungeonLevel : contains
DungeonLevel --> Room : contains
Room --> Monster : contains
Room --> Item : floor items
Room --> Chest : contains
Chest --> Item : contains contents
Main --> GameWorld : instantiates
Main --> Player : instantiates
GameConfig --> Json : parses configs via
MonsterFactory --> Json : parses blueprints via
GameConfig --> RandomSource : provides seed to
Monster --> RandomSource : uses variance from
Room --> RandomSource : picks flavor from
GameWorld --> RandomSource : calculates counts from
Main --> RandomSource : reseeds
Main --> GameConfig : reads settings from