classDiagram
    direction TB

%% --- CORE & ENTITIES ---
    class Entity {
        <<abstract>>
        # String name
        # int hp
        # int maxHp
        # int attackPower
        # int defense
        + getName() String
        + getHp() int
        + getMaxHp() int
        + getAttackPower() int
        + getDefense() int
        + isAlive() boolean
        + takeDamage(int amount)
        + heal(int amount)
        + describe()* String
        + toString() String
    }

    class Player {
        - int gold
        - int xp
        + Player(String name)
        + getGold() int
        + getXp() int
        + addGold(int g)
        + addXp(int x)
        + carryCapacity() double
        + describe() String
    }

    class Monster {
        - String species
        - int xpReward
        - CombatStrategy strategy
        + Monster(String species, int maxHp, int attackPower, int xpReward)
        + getSpecies() String
        + getXpReward() int
        + getStrategy() CombatStrategy
        + setStrategy(CombatStrategy strategy)
        + hpFraction() double
        + describe() String
    }

    class Room {
        - String id
        - String flavor
        - List~Monster~ monsters
        - List~Item~ floorItems
        - Chest chest
        + Room(String id)
        + getId() String
        + getFlavor() String
        + setFlavor(String f)
        + getMonsters() List~Monster~
        + addMonster(Monster m)
        + getFloorItems() List~Item~
        + addItem(Item i)
        + getChest() Chest
        + setChest(Chest c)
        + hasChest() boolean
    }

    class DungeonLevel {
        - int depth
        - ThemeKit themeKit
        - List~Room~ rooms
        + DungeonLevel(int depth, ThemeKit themeKit)
        + getDepth() int
        + getThemeKit() ThemeKit
        + getRooms() List~Room~
        + addRoom(Room r)
    }

    class GameWorld {
        - Player player
        - MonsterFactory monsterFactory
        - ThemeRegistry themes
        - List~DungeonLevel~ levels
        + GameWorld(Player player)
        + getPlayer() Player
        + getLevels() List~DungeonLevel~
        + getMonsterFactory() MonsterFactory
        + getThemes() ThemeRegistry
        + totalMonsters() int
        + totalLoot() int
    }

    class Combat {
        - EventBus bus
        - int MAX_ROUNDS$
        + Combat(EventBus bus)
        + fight(Player player, Room room, int depth) boolean
        + restAfterRoom(Player player)$
    }

    class Action {
        + enum Type
        - Type type
        - Entity target
        - String flavor
        + Action(Type type, Entity target, String flavor)
        + wait(String flavor)$ Action
        + getType() Type
        + getTarget() Entity
        + getFlavor() String
    }

%% --- DESIGN PATTERN 1: SINGLETON ---
    class GameConfig {
        - GameConfig instance$
        - Map~String, Object~ settings
        - GameConfig()
        + getInstance()$ GameConfig
        + readResource(String resourceName)$ String
        + getInt(String key) int
        + getDouble(String key) double
        + getSeed() long
        + resetForTests()$
    }

    class RandomSource {
        - RandomSource instance$
        - Random rng
        - long seed
        - RandomSource()
        + getInstance()$ RandomSource
        + nextInt(int bound) int
        + between(int lo, int hi) int
        + nextDouble() double
        + pick(List~T~ options) T
        + pick(T[] options) T
        + getSeed() long
        + reseed(long newSeed)
        + resetForTests()$
    }

%% --- DESIGN PATTERN 2: STRATEGY ---
    class CombatStrategy {
        <<interface>>
        + chooseAction(Monster self, Player player, Room room) Action
        + name() String
    }

    class AggressiveStrategy {
        + chooseAction(Monster self, Player player, Room room) Action
        + name() String
    }

    class HealerStrategy {
        + chooseAction(Monster self, Player target, Room room) Action
        + name() String
    }

    class RangedStrategy {
        + chooseAction(Monster self, Player target, Room room) Action
        + name() String
    }

    class SkittishStrategy {
        + chooseAction(Monster self, Player target, Room room) Action
        + name() String
    }

%% --- DESIGN PATTERN 3: SIMPLE FACTORY IDIOM ---
    class MonsterFactory {
        - Map~String, MonsterDef~ blueprints
        + MonsterFactory()
        + register(MonsterDef def)
        + create(String id, int depth) Monster
        + idsForTheme(String name) List~String~
        + bossIdFromTheme(String theme) String
        + has(String id) boolean
        + blueprintCount() int
        + strategyFor(String name)$ CombatStrategy
    }

    class MonsterDef {
        + String id
        + String name
        + int hp
        + int attack
        + int xp
        + String theme
        + boolean boss
        + String strategy
        + MonsterDef(...)
        + getId() String
        + getName() String
        + getHp() int
        + getAttack() int
        + getXp() int
        + getTheme() String
        + isBoss() boolean
        + getStrategy() String
        + toString() String
    }

%% --- DESIGN PATTERN 4: ABSTRACT FACTORY ---
    class ThemeKit {
        <<interface>>
        + themeName() String
        + createMonster(int depth) MonsterDef
        + createBoss(int depth) MonsterDef
        + createLoot(int depth) Item
        + createRoomFlavor() String
        + getMonsterFactory() MonsterFactory
    }

    class ThemeRegistry {
        - List~ThemeKit~ kits
        + ThemeRegistry(MonsterFactory factory)
        + forDepth(int depth) ThemeKit
        + size() int
        + themeNames() List~String~
    }

    class CryptThemeKit {
        - MonsterFactory monsterFactory
        + CryptThemeKit(MonsterFactory monsterFactory)
        + themeName() String
        + createMonster(int depth) MonsterDef
        + createBoss(int depth) MonsterDef
        + createLoot(int depth) Item
        + createRoomFlavor() String
        + getMonsterFactory() MonsterFactory
    }

    class ForgeThemeKit {
        - MonsterFactory monsterFactory
        + ForgeThemeKit(MonsterFactory monsterFactory)
        + themeName() String
        + createMonster(int depth) MonsterDef
        + createBoss(int depth) MonsterDef
        + createLoot(int depth) Item
        + createRoomFlavor() String
        + getMonsterFactory() MonsterFactory
    }

    class FrostThemeKit {
        - MonsterFactory monsterFactory
        + FrostThemeKit(MonsterFactory monsterFactory)
        + themeName() String
        + createMonster(int depth) MonsterDef
        + createBoss(int depth) MonsterDef
        + createLoot(int depth) Item
        + createRoomFlavor() String
        + getMonsterFactory() MonsterFactory
    }

    class VolcanicThemeKit {
        - MonsterFactory monsterFactory
        + VolcanicThemeKit(MonsterFactory monsterFactory)
        + themeName() String
        + createMonster(int depth) MonsterDef
        + createBoss(int depth) MonsterDef
        + createLoot(int depth) Item
        + createRoomFlavor() String
        + getMonsterFactory() MonsterFactory
    }

%% --- DESIGN PATTERN 5: FACTORY METHOD ---
    class RoomPopulator {
        <<abstract>>
        # ThemeKit theme
        # RoomPopulator(ThemeKit theme)
        + populate(Room room, int depth)
        # createEncounter(int depth)* List~Monster~
        # createChest(int depth) Chest
        + kind()* String
    }

    class StandardRoomPopulator {
        + StandardRoomPopulator(ThemeKit theme)
        + kind() String
        # createEncounter(int depth) List~Monster~
    }

    class TreasureRoomPopulator {
        + TreasureRoomPopulator(ThemeKit theme)
        + kind() String
        # createEncounter(int depth) List~Monster~
        # createChest(int depth) Chest
    }

    class BossRoomPopulator {
        + BossRoomPopulator(ThemeKit theme)
        + kind() String
        # createEncounter(int depth) List~Monster~
        # createChest(int depth) Chest
    }

%% --- DESIGN PATTERN 6: OBSERVER ---
    class GameEventListener {
        <<interface>>
        + onEvent(GameEvent event)
    }

    class EventBus {
        - List~GameEventListener~ listeners
        + subscribe(GameEventListener listener)
        + unsubscribe(GameEventListener listener)
        + publish(GameEvent event)
        + message(String text)
        + listenersCount() int
    }

    class AchievementSystem {
        - Set~String~ unlocked
        - EventBus bus
        - int kills
        - int fled
        - int deepestLevel
        + AchievementSystem(EventBus bus)
        + onEvent(GameEvent event)
        + getUnlocked() Set~String~
    }

    class CombatLog {
        - Deque~String~ lines
        - int maxLines
        + CombatLog(int maxLines)
        + onEvent(GameEvent event)
        + getLines() Deque~String~
        + size() int
    }

    class QuestTracker {
        - List~Quest~ quests
        - EventBus bus
        + QuestTracker(EventBus bus)
        + onEvent(GameEvent event)
        + getQuests() List~Quest~
        + completedCount() int
    }

    class Quest {
        - String id
        - String description
        - EventType trigger
        - int required
        - int progress
        + Quest(String id, String description, EventType trigger, int required)
        + getId() String
        + getDescription() String
        + getTrigger() EventType
        + getRequired() int
        + getProgress() int
        + isComplete() boolean
        + advance() boolean
        + toString() String
    }

    class GameEvent {
        - EventType type
        - Map~String, Object~ payload
        + GameEvent(EventType type)
        + of(EventType type, Object... keyValuePairs)$ GameEvent
        + message(String text)$ GameEvent
        + getType() EventType
        + get(String key) Object
        + getString(String key) String
        + getInt(String key) int
        + toString() String
    }

    class EventType {
        <<enumeration>>
        DAMAGE_DEALT
        DAMAGE_TAKEN
        MONSTER_DIED
        MONSTER_FLED
        MONSTER_HEALED
        STRATEGY_CHANGED
        XP_GAINED
        GOLD_GAINED
        LEVEL_ENTERED
        ROOM_CLEARED
        PLAYER_DIED
        DELVE_SURVIVED
        MESSAGE
    }

%% --- ITEMS & UTILITIES ---
    class Item {
        <<interface>>
        + getName() String
        + getWeight() double
        + getValue() int
        + describe() String
    }

    class Weapon {
        - String name
        - double weight
        - int value
        - int damage
        + Weapon(String name, double weight, int value, int damage)
        + getName() String
        + getWeight() double
        + getValue() int
        + getDamage() int
        + describe() String
    }

    class Armor {
        - String name
        - double weight
        - int value
        - int defense
        + Armor(String name, double weight, int value, int defense)
        + getName() String
        + getWeight() double
        + getValue() int
        + getDefense() int
        + describe() String
    }

    class Potion {
        - String name
        - double weight
        - int value
        - int healAmount
        + Potion(String name, double weight, int value, int healAmount)
        + getName() String
        + getWeight() double
        + getValue() int
        + getHealAmount() int
        + describe() String
    }

    class Treasure {
        - String name
        - double weight
        - int value
        + Treasure(String name, double weight, int value)
        + getName() String
        + getWeight() double
        + getValue() int
    }

    class Chest {
        - String name
        - List~Item~ contents
        + Chest(String name)
        + getName() String
        + getContents() List~Item~
        + add(Item item)
        + isEmpty() boolean
        + totalValue() int
    }

    class Json {
        - String s
        - int i
        - Json(String s)
        + parseObject(String text)$ Map~String, Object~
    }

    class Main {
        + VERSION$ String
        + banner()$ String
        + main(String[] args)$
    }

%% --- RELATIONSHIPS & INHERITANCE ---
    Entity <|-- Player : extends
    Entity <|-- Monster : extends

    CombatStrategy <|.. AggressiveStrategy : implements
    CombatStrategy <|.. HealerStrategy : implements
    CombatStrategy <|.. RangedStrategy : implements
    CombatStrategy <|.. SkittishStrategy : implements

    ThemeKit <|.. CryptThemeKit : implements
    ThemeKit <|.. ForgeThemeKit : implements
    ThemeKit <|.. FrostThemeKit : implements
    ThemeKit <|.. VolcanicThemeKit : implements

    RoomPopulator <|-- StandardRoomPopulator : extends
    RoomPopulator <|-- TreasureRoomPopulator : extends
    RoomPopulator <|-- BossRoomPopulator : extends

    GameEventListener <|.. AchievementSystem : implements
    GameEventListener <|.. CombatLog : implements
    GameEventListener <|.. QuestTracker : implements

    Item <|.. Weapon : implements
    Item <|.. Armor : implements
    Item <|.. Potion : implements
    Item <|.. Treasure : implements

    Monster --> CombatStrategy : holds strategy
    GameWorld --> Player : contains
    GameWorld --> MonsterFactory : contains
    GameWorld --> ThemeRegistry : contains
    GameWorld --> DungeonLevel : contains
    DungeonLevel --> ThemeKit : uses
    DungeonLevel --> Room : contains
    Room --> Monster : contains
    Room --> Chest : contains
    Chest --> Item : contains
    ThemeRegistry --> ThemeKit : manages
    ThemeKit --> MonsterFactory : uses
    MonsterFactory --> MonsterDef : uses blueprints
    Combat --> EventBus : publishes events
    EventBus --> GameEventListener : notifies
    AchievementSystem --> EventBus : listens via
    CombatLog --> EventBus : listens via
    QuestTracker --> EventBus : listens via
    QuestTracker --> Quest : manages
    GameEvent --> EventType : has type